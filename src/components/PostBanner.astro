---
import { Image } from 'astro:assets'
import GenArt from '~/components/GenArt.astro'
import type { ImageMetadata } from 'astro'

interface Props {
  seed: string
  no?: number
  date: string
  minutes?: number
  words?: number
  cover?: ImageMetadata
  coverAlt?: string
}
const { seed, no, date, minutes, words, cover, coverAlt } = Astro.props

// seeded decorative glyph strip (the little mono run under the art)
function hash(str: string): number {
  let h = 1779033703 ^ str.length
  for (let i = 0; i < str.length; i++) { h = Math.imul(h ^ str.charCodeAt(i), 3432918353); h = (h << 13) | (h >>> 19) }
  return (h ^ (h >>> 16)) >>> 0
}
const glyphs = '·¡⌐¬…∴∷⁘⁙‥∙°'.split('')
let s = hash(seed)
const strip = Array.from({ length: 12 }, () => {
  s = (s * 1664525 + 1013904223) >>> 0
  return glyphs[s % glyphs.length]
}).join(' ')

const noStr = no != null ? String(no).padStart(3, '0') : undefined
const mode = cover ? 'image' : 'art'
---

<figure class="post-banner" data-mode={mode} data-view="image" data-variant="halftone">
  <div class="post-banner-art">
    {cover ? (
      <>
        <Image
          priority
          src={cover}
          alt={coverAlt || ''}
          class="pb-cover"
          widths={[640, 960, 1280]}
          sizes="(min-width: 768px) 44rem, 100vw"
        />
        <canvas class="pb-dither" aria-hidden="true"></canvas>
      </>
    ) : (
      <GenArt seed={seed} both ratio={2.4} />
    )}
    <button class="post-banner-toggle" type="button" aria-label="Toggle banner view" title="Toggle banner view">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="8" height="16" rx="1.5"/><rect x="13" y="4" width="8" height="16" rx="1.5"/>
      </svg>
    </button>
  </div>
  <figcaption class="post-banner-glyphs mono" aria-hidden="true">{strip}</figcaption>
</figure>

<dl class="post-meta-row">
  {noStr && (
    <div class="pm-cell"><dt>No.</dt><dd class="pm-no"><span class="pm-tick"></span>{noStr}</dd></div>
  )}
  <div class="pm-cell"><dt>Date</dt><dd>{date}</dd></div>
  {minutes != null && (
    <div class="pm-cell"><dt>Length</dt><dd>{minutes} min</dd></div>
  )}
  {words != null && (
    <div class="pm-cell"><dt>Words</dt><dd>{words.toLocaleString()}</dd></div>
  )}
</dl>

<script>
  import { animateDither } from '~/scripts/halftone'

  function initBanners() {
    document.querySelectorAll<HTMLElement>('.post-banner').forEach((banner) => {
      const mode = banner.getAttribute('data-mode')
      const img = banner.querySelector<HTMLImageElement>('.pb-cover')
      const canvas = banner.querySelector<HTMLCanvasElement>('.pb-dither')
      const art = banner.querySelector<HTMLElement>('.post-banner-art')
      let animating = false
      let dithered = false

      const inkColor = () => getComputedStyle(art || banner).getPropertyValue('color').trim() || '#26221c'

      const toImage = () => {
        if (mode !== 'image') return
        banner.setAttribute('data-view', 'image')
      }

      const toggle = () => {
        if (mode !== 'image') {
          banner.setAttribute('data-variant', banner.getAttribute('data-variant') === 'halftone' ? 'graph' : 'halftone')
          return
        }
        if (!img || !canvas || animating) return
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        animating = true
        banner.setAttribute('data-view', 'dither') // fades canvas layer in via CSS opacity
        if (reduce) {
          animateDither(canvas, img, inkColor(), { reverse: dithered, duration: 1 })
          dithered = !dithered
          if (img) img.style.opacity = dithered ? '0' : '1'
          if (!dithered) banner.setAttribute('data-view', 'image')
          animating = false
          return
        }
        animateDither(canvas, img, inkColor(), {
          reverse: dithered,
          duration: 950,
          onProgress: (t) => { if (img) img.style.opacity = String(1 - t) },
          onDone: () => {
            dithered = !dithered
            if (!dithered) { banner.setAttribute('data-view', 'image'); if (img) img.style.opacity = '1' }
            animating = false
          },
        })
      }

      banner.querySelector('.post-banner-toggle')?.addEventListener('click', (e) => { e.stopPropagation(); toggle() })
      art?.addEventListener('click', toggle)
    })
  }
  document.addEventListener('astro:page-load', initBanners)
</script>
