---
import type { MarkdownHeading } from 'astro'
import TOCHeading from '~/components/TableOfContentsHeading.astro'

interface Props {
  headings: MarkdownHeading[]
}

const { headings } = Astro.props

const filteredHeadings = headings.filter(({ depth }) => depth >= 2 && depth <= 3)
---

<details class="toc" id="toc">
  <summary class="toc-summary">
    <div class="toc-summary-left">
      <span class="toc-badge">TOC</span>
      <span class="toc-caret">On this page</span>
      <svg
        class="toc-chevron"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m6 9 6 6 6-6"></path>
      </svg>
    </div>
    <a class="toc-back" href="/posts" onclick="event.stopPropagation()">↩ Writing</a>
  </summary>
  <nav class="toc-nav" aria-label="Table of contents">
    <ul class="toc-list">
      {filteredHeadings.map((heading) => <TOCHeading heading={heading} />)}
    </ul>
    <button class="toc-top" type="button">↑ Top</button>
  </nav>
</details>

<script>
  const tocWindow = window as Window & {
    tocObserver?: IntersectionObserver
    tocResizeHandler?: () => void
  }

  function initTableOfContents() {
    tocWindow.tocObserver?.disconnect()
    if (tocWindow.tocResizeHandler) {
      window.removeEventListener('resize', tocWindow.tocResizeHandler)
    }

    const toc = document.getElementById('toc') as HTMLDetailsElement | null
    if (!toc) return

    const applyLayoutState = () => {
      if (window.innerWidth >= 1280) {
        toc.open = true
      } else {
        toc.open = false
      }
    }
    applyLayoutState()

    tocWindow.tocResizeHandler = () => {
      if (window.innerWidth >= 1280) {
        toc.open = true
      }
    }
    window.addEventListener('resize', tocWindow.tocResizeHandler)

    // Prevent accidental toggling of details on desktop when clicking summary header
    const summary = toc.querySelector<HTMLElement>('.toc-summary')
    summary?.addEventListener('click', (e) => {
      if (window.innerWidth >= 1280) {
        e.preventDefault()
      }
    })

    // Smooth transition / scrolling when clicking TOC links
    toc.querySelectorAll<HTMLAnchorElement>('.toc-link').forEach((link) => {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href')
        if (!href || !href.startsWith('#')) return
        const targetId = decodeURIComponent(href.slice(1))
        const targetEl = document.getElementById(targetId)
        if (!targetEl) return

        e.preventDefault()

        // Push URL state without jump
        history.pushState(null, '', href)

        // Clear header clearance (85px)
        const headerOffset = 85
        const targetTop =
          targetEl.getBoundingClientRect().top + window.pageYOffset - headerOffset

        window.scrollTo({
          top: targetTop,
          behavior: 'smooth',
        })

        // On mobile, close drawer after selection
        if (window.innerWidth < 1280) {
          toc.open = false
        }
      })
    })

    const anchors = [...document.querySelectorAll<HTMLElement>('h2[id], h3[id]')]
    const links = [...document.querySelectorAll<HTMLElement>('.toc-list > li')]

    const topBtn = document.querySelector<HTMLButtonElement>('.toc-top')
    topBtn?.addEventListener('click', (e) => {
      e.preventDefault()
      window.scrollTo({ top: 0, behavior: 'smooth' })
      if (window.innerWidth < 1280) {
        toc.open = false
      }
    })

    if (anchors.length !== links.length || anchors.length === 0) return

    const setActive = (index: number) => {
      links.forEach((link, linkIndex) => {
        const isActive = linkIndex === index
        link.classList.toggle('active-heading', isActive)
        // Keep active heading visible inside TOC scroll viewport on desktop
        if (isActive && window.innerWidth >= 1280) {
          const tocRect = toc.getBoundingClientRect()
          const linkRect = link.getBoundingClientRect()
          if (linkRect.top < tocRect.top + 36) {
            toc.scrollTop -= tocRect.top + 36 - linkRect.top
          } else if (linkRect.bottom > tocRect.bottom - 24) {
            toc.scrollTop += linkRect.bottom - (tocRect.bottom - 24)
          }
        }
      })
    }

    tocWindow.tocObserver = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0]
        if (visible) setActive(anchors.indexOf(visible.target as HTMLElement))
      },
      { rootMargin: '-70px 0px -65% 0px', threshold: 0 },
    )

    anchors.forEach((anchor) => tocWindow.tocObserver?.observe(anchor))
  }

  document.addEventListener('astro:page-load', initTableOfContents)
  document.addEventListener('astro:before-swap', () => {
    tocWindow.tocObserver?.disconnect()
    if (tocWindow.tocResizeHandler) {
      window.removeEventListener('resize', tocWindow.tocResizeHandler)
    }
  })
</script>
