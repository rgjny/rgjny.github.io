---
import { Image } from 'astro:assets'
import Icon from '~/components/Icon.astro'
import InlineMark from '~/components/InlineMark.astro'
import siteConfig from '~/site.config'
import type { FrontmatterImage } from '~/types'

interface Props {
  avatarImage?: FrontmatterImage
  githubCalendar?: string
  postCount?: number
}

const { avatarImage, postCount = 0 } = Astro.props
const gh = siteConfig.socialLinks?.github
const email = siteConfig.socialLinks?.email
const tw = siteConfig.socialLinks?.twitter

// Quick-link trio: icon, label, count
const trio = [
  { icon: 'pen',    name: 'Writing', meta: `${postCount} ${postCount === 1 ? 'post' : 'posts'}`, href: '/posts' },
  { icon: 'face',   name: 'About',   meta: 'who I am',    href: '/about' },
  { icon: 'github', name: 'GitHub',  meta: '@rgjny',      href: gh ?? '#', external: true },
] as const
---

<section class="hero">
  <div class="plate">
    <div class="plate-main">
      <h1 class="hero-name" aria-label="rgjny">
        {'rgjny'.split('').map((ch, i) => (
          <span class="name-letter" style={`--i: ${i}`} aria-hidden="true">{ch}</span>
        ))}
        <span class="hero-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      </h1>

      <div class="hero-bio">
        <p class="fade-up" style="--d:.06s">
          I <span class="inline-phrase"><span class="inline-word">hunt</span> <span class="inline-word">bugs</span><InlineMark name="bug" /></span>
          for money, mostly on programs nobody's heard of. The interesting ones aren't the loud
          ones — they're the <span class="inline-phrase"><span class="inline-word">quiet</span> <span class="inline-word">broken</span> <span class="inline-word">thing</span><InlineMark name="search" /></span>
          sitting three steps deep that nobody bothered to check.
        </p>
        <div class="hero-slot fade-up" style="--d:.14s"><slot /></div>
        <p class="fade-up" style="--d:.22s">
          Find me at
          {gh && (<><a href={gh} target="_blank" rel="noopener noreferrer">GitHub<Icon name="ext" class="ext-mark" /></a>{(tw || email) ? ', ' : ''}</>)}
          {tw && (<><a href={tw} target="_blank" rel="noopener noreferrer">@rgjny_<Icon name="ext" class="ext-mark" /></a>{email ? ' and ' : ''}</>)}
          {email && (<a href={`mailto:${email}`}>{email}</a>)}
        </p>
      </div>
    </div>

    {avatarImage && (
      <figure class="hero-portrait fade-up" style="--d:.12s">
        <div class="portrait-frame" data-halftone-avatar>
          <Image
            src={avatarImage.src}
            alt={avatarImage.alt}
            class="portrait-src"
            widths={[240, 480]}
            sizes="240px"
            height={480}
            width={480}
          />
          <canvas class="portrait-halftone" aria-hidden="true"></canvas>
        </div>
      </figure>
    )}
  </div>
</section>

<nav class="trio" aria-label="Quick links">
  {trio.map((t, i) => (
    <a
      class="trio-item scroll-reveal"
      style={`--reveal-delay: ${i * 70}ms`}
      href={t.href}
      target={t.external ? '_blank' : undefined}
      rel={t.external ? 'noopener noreferrer' : undefined}
    >
      <span class="trio-icon"><Icon name={t.icon} /></span>
      <span class="trio-text">
        <span class="trio-name">{t.name}{t.external && <Icon name="ext" class="ext-mark" />}</span>
        <span class="trio-meta">{t.meta}</span>
      </span>
    </a>
  ))}
</nav>

<script>
  import { animateDither, staticDither } from '~/scripts/halftone'

  const homeMotionWindow = window as Window & {
    homeRevealObserver?: IntersectionObserver
    homePortraitThemeObs?: MutationObserver
    homePortraitResizeObs?: ResizeObserver
  }

  function initHomeReveals() {
    homeMotionWindow.homeRevealObserver?.disconnect()
    const items = document.querySelectorAll<HTMLElement>('.scroll-reveal')
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    if (reduce || !('IntersectionObserver' in window)) {
      items.forEach((item) => item.classList.add('is-visible'))
      return
    }

    document.documentElement.classList.add('home-motion-ready')
    homeMotionWindow.homeRevealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting && entry.boundingClientRect.top >= 0) return
        entry.target.classList.add('is-visible')
        observer.unobserve(entry.target)
      })
    }, { threshold: 0.14, rootMargin: '0px 0px -5% 0px' })

    items.forEach((item) => homeMotionWindow.homeRevealObserver?.observe(item))
  }

  // Dithered portrait — halftone. Dark line-art renders as ink
  // dots (color follows the theme's text color), materializing on first paint.
  function initHalftoneAvatar() {
    const frame = document.querySelector<HTMLElement>('[data-halftone-avatar]')
    if (!frame) return
    const img = frame.querySelector<HTMLImageElement>('.portrait-src')
    const canvas = frame.querySelector<HTMLCanvasElement>('.portrait-halftone')
    if (!img || !canvas) return
    // Ink = the theme's --text. Read the custom property (not `color`) —
    // `color` is mid-transition for ~420ms after a theme flip, which would
    // repaint the portrait in the previous theme's ink.
    const ink = () =>
      getComputedStyle(frame).getPropertyValue('--text').trim() ||
      getComputedStyle(frame).color.trim() ||
      '#ecebe6'
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    const draw = () => {
      frame.classList.add('halftone-ready')
      if (reduce) { staticDither(canvas, img, ink(), 4, false); return }
      animateDither(canvas, img, ink(), { cell: 4, duration: 1100, invert: false })
    }
    if (img.complete && img.naturalWidth) draw()
    else img.addEventListener('load', draw, { once: true })

    // Repaint (no re-animation) when the theme flips so ink tracks --text.
    // The repaint is deferred past the style flush — reading the computed
    // color in the same tick as the attribute change returns the *old*
    // theme's ink and leaves the portrait invisible in the new theme.
    homeMotionWindow.homePortraitThemeObs?.disconnect()
    const obs = new MutationObserver(() => {
      requestAnimationFrame(() => {
        if (img.complete && img.naturalWidth) staticDither(canvas, img, ink(), 4, false)
      })
    })
    obs.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] })
    homeMotionWindow.homePortraitThemeObs = obs

    // Keep the canvas buffer matched to the laid-out frame — a stale buffer
    // gets CSS-stretched and the dots bloat into a blob (rotate/resize/zoom).
    homeMotionWindow.homePortraitResizeObs?.disconnect()
    let lastW = -1
    const resizeObs = new ResizeObserver(() => {
      const w = Math.round(frame.getBoundingClientRect().width)
      if (w === lastW) return
      lastW = w
      if (frame.classList.contains('halftone-ready') && img.complete && img.naturalWidth)
        staticDither(canvas, img, ink(), 4, false)
    })
    resizeObs.observe(frame)
    homeMotionWindow.homePortraitResizeObs = resizeObs
  }

  function initHome() { initHomeReveals(); initHalftoneAvatar() }
  document.addEventListener('astro:page-load', initHome)
  document.addEventListener('astro:before-swap', () => {
    homeMotionWindow.homeRevealObserver?.disconnect()
    homeMotionWindow.homePortraitThemeObs?.disconnect()
    homeMotionWindow.homePortraitResizeObs?.disconnect()
    document.documentElement.classList.remove('home-motion-ready')
  })
</script>
