---
import { Image } from 'astro:assets'
import GitHubActivityCalendar from '~/components/GitHubActivityCalendar.astro'
import type { FrontmatterImage } from '~/types'

interface Props {
  avatarImage?: FrontmatterImage
  githubCalendar?: string
}
const { avatarImage, githubCalendar } = Astro.props

const focus = [
  { mark: 'HTTP', name: 'Web & APIs', desc: 'Broken access control, IDOR, SSRF, and injection.' },
  { mark: 'AUTH', name: 'Auth & Logic', desc: 'Privilege escalation, session flaws, and flow abuse.' },
  { mark: 'APK', name: 'Mobile', desc: 'Android and iOS clients, plus the traffic behind them.' },
  { mark: 'IAM', name: 'Cloud', desc: 'Misconfigurations, metadata, and trust between services.' },
]
---

<section class="hero">
  <div class="hero-eyebrow">
    <span class="he-tick"></span>
    <span class="he-text">Security research / est. 2025</span>
  </div>

  <div class="plate">
    <div class="plate-main">
      <h1 class="hero-name">rgjny<span class="dot">.</span><span class="term-caret" aria-hidden="true">_</span></h1>
      <div class="hero-rule" aria-hidden="true"></div>
      <p class="hero-role">
        Bug-bounty hunter chasing the <em>gap</em> between how a system should work and what it really does.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="/posts">Read the journal</a>
        <a class="button button-secondary" href="mailto:rgjnymail@proton.me">Send an email</a>
      </div>
    </div>

    {avatarImage && (
      <figure class="hero-portrait">
        <div class="portrait-frame">
          <Image
            priority
            src={avatarImage.src}
            alt={avatarImage.alt}
            class="portrait-img"
            widths={[256, 384]}
            sizes="(min-width: 768px) 12rem, 8rem"
            height={152}
            width={152}
          />
        </div>
        <figcaption class="portrait-caption">
          <span>Independent security research</span>
          <span>Web, mobile, and cloud</span>
        </figcaption>
      </figure>
    )}
  </div>

</section>

<section class="profile-note" aria-label="Current work">
  <div class="hero-foot">
    <div class="hero-status">
      <span class="status-dot"></span>
      <span>Currently hunting</span>
    </div>
    <div class="hero-intro prose"><slot /></div>
  </div>
</section>

<section class="focus" aria-labelledby="focus-title">
  <h2 id="focus-title" class="focus-title">What I investigate</h2>
  <div class="focus-grid">
      {focus.map((f, index) => (
        <article class="focus-item scroll-reveal" style={`--reveal-delay: ${index * 70}ms`}>
          <span class="fx-mark">{f.mark}</span>
          <h3 class="fx-name">{f.name}</h3>
          <p class="fx-desc">{f.desc}</p>
        </article>
      ))}
  </div>
</section>

{githubCalendar && <GitHubActivityCalendar username={githubCalendar} />}

<script>
  const homeMotionWindow = window as Window & { homeRevealObserver?: IntersectionObserver }

  function initHomeReveals() {
    homeMotionWindow.homeRevealObserver?.disconnect()
    const items = document.querySelectorAll<HTMLElement>('.scroll-reveal')
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    if (reduce || !('IntersectionObserver' in window)) {
      items.forEach((item) => item.classList.add('is-visible'))
      return
    }

    document.documentElement.classList.add('home-motion-ready')
    homeMotionWindow.homeRevealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting && entry.boundingClientRect.top >= 0) return
        entry.target.classList.add('is-visible')
        observer.unobserve(entry.target)
      })
    }, { threshold: 0.14, rootMargin: '0px 0px -5% 0px' })

    items.forEach((item) => homeMotionWindow.homeRevealObserver?.observe(item))
  }

  document.addEventListener('astro:page-load', initHomeReveals)
  document.addEventListener('astro:before-swap', () => {
    homeMotionWindow.homeRevealObserver?.disconnect()
    document.documentElement.classList.remove('home-motion-ready')
  })
</script>
