---
interface Props {
  /** Two-digit section number shown in the mono eyebrow, e.g. "03". */
  num?: string
}
const { num } = Astro.props
---

<div class="block-header-wrapper">
  <div class="block-header-title">
    {num && <span class="block-header-num">{num}</span>}
    <span class="block-header-label"><slot /></span>
    <span class="block-header-line"></span>
  </div>
</div>
