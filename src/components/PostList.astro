---
import { Image } from 'astro:assets'
import GenArt from '~/components/GenArt.astro'
import type { CollectionEntry } from 'astro:content'

interface Props {
  posts: CollectionEntry<'posts'>[]
}
const { posts } = Astro.props

function shortDate(d: Date) {
  const dd = String(d.getUTCDate()).padStart(2, '0')
  const mm = String(d.getUTCMonth() + 1).padStart(2, '0')
  const yy = String(d.getUTCFullYear()).slice(2)
  return `${dd}/${mm}/${yy}`
}
---

<ul class="wr-list">
  {posts.map((post) => (
    <li>
      <a class="wr-row" href={`/posts/${post.id}`}>
        <span class="wr-thumb" data-thumb>
          {post.data.coverImage ? (
            <>
              <canvas class="wr-dither" aria-hidden="true"></canvas>
              <Image
                class="wr-photo"
                src={post.data.coverImage.src}
                alt=""
                widths={[96, 192]}
                sizes="96px"
                loading="lazy"
              />
            </>
          ) : (
            <GenArt seed={post.id} variant="halftone" ratio={1.5} />
          )}
        </span>
        <span class="wr-title">{post.data.title}</span>
        <span class="wr-leader" aria-hidden="true"></span>
        <time class="wr-date mono">{shortDate(post.data.published)}</time>
      </a>
    </li>
  ))}
</ul>

<script>
  import { staticDither } from '~/scripts/halftone'

  const thumbWin = window as Window & { wrThumbThemeObs?: MutationObserver }

  function renderThumbs() {
    document.querySelectorAll<HTMLElement>('.wr-thumb[data-thumb]').forEach((thumb) => {
      const img = thumb.querySelector<HTMLImageElement>('.wr-photo')
      const canvas = thumb.querySelector<HTMLCanvasElement>('.wr-dither')
      if (!img || !canvas) return
      const ink = getComputedStyle(thumb).getPropertyValue('color').trim() || '#26221c'
      const render = () => { if (staticDither(canvas, img, ink, 3)) thumb.classList.add('thumb-ready') }
      if (img.complete && img.naturalWidth) render()
      else img.addEventListener('load', render, { once: true })
    })
  }

  function initThumbs() {
    renderThumbs()
    // Re-ink when the theme flips so thumbnails keep contrast in both modes.
    thumbWin.wrThumbThemeObs?.disconnect()
    const obs = new MutationObserver(() => renderThumbs())
    obs.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] })
    thumbWin.wrThumbThemeObs = obs
  }
  document.addEventListener('astro:page-load', initThumbs)
  document.addEventListener('astro:before-swap', () => thumbWin.wrThumbThemeObs?.disconnect())
</script>
